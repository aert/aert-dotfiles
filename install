#!/usr/bin/env bash
#
# Apply the dotfiles with mise bootstrap (https://mise.jdx.dev/bootstrap.html):
# links the [dotfiles] of mise.dotfiles.toml + mise.<os>.toml, runs their hooks
# (Gnome settings on Linux), then installs the global [tools] of mise.toml.
#
# Usage:
#   ./install        # apply (idempotent; existing plain files are left alone)
#   ./install -n     # dry run: show what would change
#   ./install ARGS   # any other `mise bootstrap` flag, e.g. --force-dotfiles, --prune-dotfiles
#
# New machine: install mise, clone this repo, `mise trust` it, then ./install.

set -e

DIR="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  OS=linux ;;
  Darwin) OS=macos ;;
  *)
    echo "Unknown OS: $(uname -s)" >&2
    exit 1
    ;;
esac

exec mise -C "$DIR" -E "dotfiles,$OS" bootstrap --only dotfiles,tools "$@"
