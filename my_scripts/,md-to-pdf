#!/usr/bin/env -S ,mise-global-exec ruby
# frozen_string_literal: true
# Requires @mermaid-js/mermaid-cli (bundles puppeteer/Chromium — used for both mermaid
# pre-rendering and PDF generation); optionally plantuml (pre-renders ```plantuml fences the same
# way; without it they render as code blocks). Run ,__install_requirements.sh to install/upgrade
# everything — see ,md-to-html's header. Like ,md-to-html, this runs on the global mise toolset
# via ,mise-global-exec, ignoring any project-local mise versions.
#
# Multi-file documents without duplicating content: inherited from ,md-to-html (see its header)
# — a line `<!-- include: relative/path.md -->` in the input file is replaced with that file's
# content before rendering, recursively, relative to each file's own directory. E.g. an index.md
# that's just a title + a list of `<!-- include: ... -->` lines renders as one PDF containing
# every referenced file, with edits to those files picked up on the next run — nothing to
# regenerate or keep in sync by hand.
#
# Image paths (in the top-level file and in anything it includes) are rewritten to absolute
# filesystem paths as part of loading, so relative `![](...)` links resolve correctly even
# though rendering here goes through a Puppeteer tempfile HTML in a different directory (see
# run_puppeteer_pdf below) — no need to inline images as base64.

load File.join(File.dirname(File.realpath(__FILE__)), ',md-to-html')

require 'tempfile'
require 'open3'

#-- MarkdownToPdfConverter -------------------------------------------------

class MarkdownToPdfConverter < MarkdownToHtmlConverter
  # Printable page heights (mm) for the formats puppeteer accepts as `format:`.
  # Used to constrain diagram SVGs so no diagram ever spans two pages.
  PAGE_HEIGHTS_MM = {
    'A0' => 1189, 'A1' => 841, 'A2' => 594, 'A3' => 420,
    'A4' => 297, 'A5' => 210, 'A6' => 148,
    'LETTER' => 279.4, 'LEGAL' => 355.6,
    'TABLOID' => 431.8, 'LEDGER' => 279.4
  }.freeze

  def initialize(input_paths:, output_dir: nil, simulate: false, page_size: 'A4', margin: 10)
    @page_size = page_size
    @margin = margin
    super(input_paths: input_paths, output_dir: output_dir, standalone: true, simulate: simulate)
    say "Page: #{page_size}, Margin: #{margin}mm", subitem: true
    say "Mermaid: #{mmdc_available? ? 'mmdc found — pre-rendering to SVG' : 'mmdc not found — diagrams shown as code'}", subitem: true
    say "PDF engine: puppeteer (#{puppeteer_path || 'not found — will fail'})", subitem: true
  end

  private

  # Override: pre-render mermaid blocks to inline SVG instead of CDN JS
  def process_mermaid(html)
    html.gsub(/<pre lang="mermaid"[^>]*><code[^>]*>(.*?)<\/code><\/pre>/m) do
      content = Regexp.last_match(1).gsub(/<\/?span[^>]*>/, '')
      content = decode_html_entities(content)
      render_mermaid_to_svg(content) || "<pre><code>#{content}</code></pre>"
    end
  end

  # Override: build PDF-specific HTML — no CDN, no body padding (puppeteer handles margins)
  def wrap_in_html_document(body_html, input_path)
    title = input_path.basename('.*').to_s.tr('_-', ' ').capitalize

    <<~HTML
      <!DOCTYPE html>
      <html lang="en">
      <head>
        <meta charset="UTF-8">
        <title>#{title}</title>
        <style>#{html_styles(extra_css: "body { padding: 0; font-size: 11px; } #{diagram_fit_css}")}</style>
      </head>
      <body>
        #{body_html}
      </body>
      </html>
    HTML
  end

  # CSS so a diagram never spans two pages:
  # - break-inside: avoid keeps the (now page-fitting) block unbreakable
  # - max-height scales taller SVGs down to the printable page height
  # - width/height: auto !important is what actually keeps the aspect ratio: mmdc's SVGs default
  #   to preserveAspectRatio="meet" and an unset height, so capping only max-width happened to
  #   look fine on them, but PlantUML's SVGs carry a *fixed* pixel width AND height (as attributes
  #   and inline style) plus preserveAspectRatio="none" — constraining max-width or max-height
  #   alone (without freeing the other axis back to auto) leaves the other axis pinned at that
  #   fixed value, so the box's aspect ratio drifts from the diagram's own and the content
  #   visibly stretches to fill it. Forcing both to auto restores the standard "auto/auto plus
  #   max-width/max-height" replaced-element sizing algorithm (same idiom as `img{max-width:100%;
  #   height:auto}`), which scales the whole box down uniformly regardless of what fixed
  #   width/height/preserveAspectRatio the source tool baked in — safe for both diagram types.
  # - !important beats the inline width/height/max-width styles both mmdc and plantuml bake in
  # A few mm are reserved for the wrapper's 1em vertical margins (html_styles),
  # so the whole block fits on a single printable page.
  def diagram_fit_css
    page_height_mm = PAGE_HEIGHTS_MM[@page_size.upcase]
    if page_height_mm.nil?
      say("Unknown page size #{@page_size.inspect} — diagrams constrained to width only", subitem: true, error: true)
      return <<~CSS
        .mermaid, .plantuml { break-inside: avoid; page-break-inside: avoid; }
        .mermaid svg, .plantuml svg { width: auto !important; height: auto !important; max-width: 100% !important; }
      CSS
    end

    svg_max_mm = [page_height_mm - 2 * @margin - 6, 20].max
    <<~CSS
      .mermaid, .plantuml { break-inside: avoid; page-break-inside: avoid; }
      .mermaid svg, .plantuml svg {
        width: auto !important;
        height: auto !important;
        max-width: 100% !important;
        max-height: #{svg_max_mm}mm !important;
      }
    CSS
  end

  def output_extension = '.pdf'

  def write_output(content, output_path)
    run_puppeteer_pdf(content, output_path.to_s)
  end

  def mmdc_available?
    return @mmdc_available unless @mmdc_available.nil?
    @mmdc_available = system('which mmdc > /dev/null 2>&1')
  end

  def render_mermaid_to_svg(content)
    return nil unless mmdc_available?

    mmd_file = Tempfile.new(['mermaid', '.mmd'])
    svg_file = Tempfile.new(['mermaid', '.svg'])

    begin
      mmd_file.write(content)
      mmd_file.close
      svg_file.close

      _, stderr, status = Open3.capture3('mmdc', '-i', mmd_file.path, '-o', svg_file.path)

      unless status.success?
        say("mmdc error: #{stderr.strip}", subitem: true, subitem_level: 3, error: true)
        return nil
      end

      svg = File.read(svg_file.path)
      "<div class=\"mermaid\">#{svg}</div>"
    ensure
      mmd_file.unlink rescue nil
      svg_file.unlink rescue nil
    end
  end

  def puppeteer_path
    return @puppeteer_path if defined?(@puppeteer_path)

    # Resolve from npm global root — puppeteer may be top-level or bundled inside mmdc
    npm_root = `npm root -g 2>/dev/null`.strip
    @puppeteer_path = if npm_root.empty?
                        nil
                      else
                        [
                          File.join(npm_root, 'puppeteer'),
                          File.join(npm_root, '@mermaid-js', 'mermaid-cli', 'node_modules', 'puppeteer'),
                        ].find { |p| File.exist?(File.join(p, 'package.json')) }
                      end
  end

  def run_puppeteer_pdf(html_content, pdf_path)
    raise 'puppeteer not found. Install mmdc: npm install -g @mermaid-js/mermaid-cli' unless puppeteer_path

    html_file = Tempfile.new(['md-to-pdf', '.html'])

    begin
      html_file.write(html_content)
      html_file.close

      js = puppeteer_js(html_file.path, pdf_path)
      js_file = Tempfile.new(['md-to-pdf', '.js'])

      begin
        js_file.write(js)
        js_file.close

        _, stderr, status = Open3.capture3('node', js_file.path)
        raise "puppeteer failed: #{stderr.strip}" unless status.success?
      ensure
        js_file.unlink rescue nil
      end
    ensure
      html_file.unlink rescue nil
    end
  end

  def puppeteer_js(html_path, pdf_path)
    <<~JS
      'use strict';
      const puppeteer = require(#{puppeteer_path.inspect});

      (async () => {
        const browser = await puppeteer.launch({
          args: ['--no-sandbox', '--disable-setuid-sandbox', '--disable-dev-shm-usage']
        });
        try {
          const page = await browser.newPage();
          await page.goto('file://#{html_path}', { waitUntil: 'networkidle0', timeout: 30000 });
          await page.pdf({
            path: #{pdf_path.inspect},
            format: #{@page_size.inspect},
            margin: {
              top:    '#{@margin}mm',
              bottom: '#{@margin}mm',
              left:   '#{@margin}mm',
              right:  '#{@margin}mm'
            },
            printBackground: true
          });
        } finally {
          await browser.close();
        }
      })().catch(err => { console.error(err.toString()); process.exit(1); });
    JS
  end
end

#-- CLI --------------------------------------------------------------------

def parse_options
  options = { simulate: false, output_dir: nil, page_size: 'A4', margin: 10 }

  parser = OptionParser.new do |opts|
    opts.banner = "Usage: #{File.basename($PROGRAM_NAME)} [options] <markdown-files...>"
    opts.separator ''
    opts.separator 'Convert Markdown to PDF via puppeteer (Mermaid pre-rendered via mmdc)'
    opts.separator ''

    opts.on('-o', '--output-dir DIR', 'Output directory (default: same as input)') do |dir|
      options[:output_dir] = dir
    end
    opts.on('-p', '--page-size SIZE', 'Page size (default: A4)') do |size|
      options[:page_size] = size
    end

    opts.on('-m', '--margin MM', Integer, 'Page margin in mm (default: 10)') do |mm|
      options[:margin] = mm
    end

    opts.on('-s', '--simulate', 'Simulate only (no PDF generation)') do
      options[:simulate] = true
    end

    opts.on('-h', '--help', 'Show this help') do
      puts opts
      exit
    end
  end

  parser.parse!
  options
rescue OptionParser::InvalidOption, OptionParser::InvalidArgument => e
  warn "Error: #{e.message}"
  warn "Use -h or --help for usage information"
  exit 1
end

def main
  options = parse_options

  if ARGV.empty?
    warn 'Error: No markdown files specified'
    warn "Usage: #{File.basename($PROGRAM_NAME)} [options] <markdown-files...>"
    warn "Use -h or --help for more information"
    exit 1
  end

  begin
    converter = MarkdownToPdfConverter.new(
      input_paths: ARGV,
      output_dir: options[:output_dir],
      simulate: options[:simulate],
      page_size: options[:page_size],
      margin: options[:margin]
    )

    converter.convert_all
  rescue StandardError => e
    warn "Fatal error: #{e.message}"
    exit 1
  end
end

main if __FILE__ == $PROGRAM_NAME
